<base:WindowBase
    x:Class="v2rayN.Views.TunnelingSettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="Tunneling Core Settings"
    Width="620"
    Height="600"
    x:TypeArguments="vms:TunnelingSettingViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button x:Name="btnSave" Width="110" Content="{x:Static resx:ResUI.TbConfirm}" IsDefault="True" Style="{StaticResource DefButton}" />
            <Button x:Name="btnCancel" Width="110" Margin="{StaticResource MarginLeftRight8}" Content="{x:Static resx:ResUI.TbCancel}" IsCancel="True" Style="{StaticResource DefButton}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Tunneling Core Settings" />
                <TextBlock Margin="0,8,0,14" TextWrapping="Wrap" Opacity="0.8"
                           Text="Select the network TUN engine used when TUN mode is enabled. Choose between the standard built-in core (sing-box) or Zeptun (high-performance userspace tun2socks written in Zig)." />

                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Tunneling Engine" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Cores}" SelectedItem="{Binding SelectedCore, Mode=TwoWay}" />
                </Grid>

                <GroupBox Margin="0,8,0,0" Header="Zeptun Settings (Noisemux/zeptun)"
                          materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                          IsEnabled="{Binding IsZeptunSelected}">
                    <StackPanel Margin="4">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.85"
                                   Text="Zeptun is a zero-dependency, ultra-fast tun2socks implementation built in Zig with elastic multi-queue workers." />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="0,4,0,0" VerticalAlignment="Center" Text="Interface Name" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,4"
                                     Text="{Binding ZeptunInterfaceName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center" Text="MTU" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,4"
                                     Text="{Binding ZeptunMtu, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Center" Text="Network Stack" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,4"
                                      ItemsSource="{Binding Stacks}" SelectedItem="{Binding ZeptunStack, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3" Margin="0,6,0,0" VerticalAlignment="Center" Text="Extra Arguments" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,4"
                                     Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding ZeptunAutoRoute}" Content="Auto-route system traffic into TUN" Margin="0,0,24,0" />
                            <CheckBox IsChecked="{Binding ZeptunStrictRoute}" Content="Strict route protection" />
                        </StackPanel>

                        <Button Margin="0,14,0,4" HorizontalAlignment="Left"
                                Command="{Binding OpenZeptunUrlCmd}"
                                Content="Open Zeptun GitHub Repository (Noisemux/zeptun)"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</base:WindowBase>
