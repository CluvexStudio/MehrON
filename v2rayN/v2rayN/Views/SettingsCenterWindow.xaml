<base:WindowBase
    x:Class="v2rayN.Views.SettingsCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuSettingsCenter}"
    Width="900"
    Height="600"
    x:TypeArguments="vms:SettingsCenterViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <Button
            x:Name="btnClose"
            Width="100"
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            Content="{x:Static resx:ResUI.menuClose}"
            DockPanel.Dock="Bottom"
            IsCancel="True"
            IsDefault="True"
            Style="{StaticResource DefButton}" />
        <TextBox
            Margin="{StaticResource Margin4}"
            VerticalAlignment="Center"
            materialDesign:HintAssist.Hint="{x:Static resx:ResUI.SettingsCenterSearch}"
            DockPanel.Dock="Top"
            Style="{StaticResource MyOutlinedTextBox}"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox
                x:Name="lstSections"
                Grid.Column="0"
                Margin="{StaticResource Margin4}"
                ItemsSource="{Binding FilteredSections}"
                SelectedItem="{Binding SelectedSection}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="{StaticResource Margin4}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.65"
                                Text="{Binding Category}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel
                Grid.Column="1"
                Margin="12,4,4,4"
                VerticalAlignment="Top">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Style="{StaticResource ModuleTitle}"
                    Text="{Binding SelectedTitle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.7"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{Binding SelectedCategory}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.7"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{Binding SelectedKeywords}"
                    TextWrapping="Wrap" />
                <Button
                    Width="140"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenSectionCmd}"
                    Content="{x:Static resx:ResUI.SettingsCenterOpen}"
                    Style="{StaticResource DefButton}" />
                <TextBlock
                    Margin="0,12,0,0"
                    Opacity="0.7"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.SettingsCenterTip}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</base:WindowBase>
