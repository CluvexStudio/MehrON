<base:WindowBase
    x:Class="v2rayN.Views.DoubleTunnelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:ServiceLib.Models;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.DoubleTunnelTitle}"
    Width="640"
    Height="480"
    x:TypeArguments="vms:DoubleTunnelViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Width="120"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
            <Button
                x:Name="btnCancel"
                Width="100"
                Margin="{StaticResource MarginLeftRight8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True"
                Style="{StaticResource DefButton}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource Margin8}">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Static resx:ResUI.DoubleTunnelTitle}" />
                <TextBlock
                    Margin="0,4,0,12"
                    FontSize="12"
                    Opacity="0.8"
                    Text="{x:Static resx:ResUI.DoubleTunnelHeaderDesc}"
                    TextWrapping="Wrap" />

                <!-- Visual Connection Flow -->
                <Border
                    Margin="0,0,0,14"
                    Padding="12"
                    BorderBrush="#40808080"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Client" />
                        <TextBlock
                            Margin="8,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Opacity="0.6"
                            Text="➔" />
                        <Border
                            Padding="8,4"
                            Background="#20808080"
                            CornerRadius="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Text="1. Middle Server" />
                        </Border>
                        <TextBlock
                            Margin="8,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Opacity="0.6"
                            Text="➔" />
                        <Border
                            Padding="8,4"
                            Background="#20808080"
                            CornerRadius="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Text="2. Exit Server" />
                        </Border>
                        <TextBlock
                            Margin="8,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Opacity="0.6"
                            Text="➔" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Internet" />
                    </StackPanel>
                </Border>

                <!-- Server Selection Form -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Middle Node -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,8"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.DoubleTunnelMiddleServer}" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,8"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Servers}"
                        SelectedItem="{Binding SelectedMiddleServer}"
                        Style="{StaticResource DefComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:ProfileItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="Medium" Text="{Binding Remarks}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.6"
                                        Text="{Binding ConfigType, StringFormat='({0})'}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.4"
                                        Text="{Binding Address}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Exit Node -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.DoubleTunnelExitServer}" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,8"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Servers}"
                        SelectedItem="{Binding SelectedExitServer}"
                        Style="{StaticResource DefComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:ProfileItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="Medium" Text="{Binding Remarks}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.6"
                                        Text="{Binding ConfigType, StringFormat='({0})'}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.4"
                                        Text="{Binding Address}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Remarks -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,8"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbRemarks}" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,8"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource DefTextBox}"
                        Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Core Type -->
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,8"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbCoreType}" />
                    <ComboBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="160"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding CoreTypes}"
                        SelectedItem="{Binding CoreType}"
                        Style="{StaticResource DefComboBox}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</base:WindowBase>
