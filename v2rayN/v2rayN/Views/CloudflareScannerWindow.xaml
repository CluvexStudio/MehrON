<base:WindowBase
    x:Class="v2rayN.Views.CloudflareScannerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.CloudflareScannerTitle}"
    Width="860"
    Height="640"
    x:TypeArguments="vms:CloudflareScannerViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <DockPanel Margin="{StaticResource Margin8}">
        <!-- Bottom Action Bar -->
        <Border
            Margin="{StaticResource Margin4}"
            Padding="8,6"
            BorderBrush="#40808080"
            BorderThickness="1"
            CornerRadius="6"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <Button
                    x:Name="btnClose"
                    Width="90"
                    Content="{x:Static resx:ResUI.TbClose}"
                    DockPanel.Dock="Right"
                    IsCancel="True"
                    Style="{StaticResource DefButton}" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="btnCopySelected"
                        Margin="0,0,6,0"
                        Content="{x:Static resx:ResUI.TbCopySelected}"
                        Style="{StaticResource DefButton}" />
                    <Button
                        x:Name="btnCopyAllWorking"
                        Margin="0,0,10,0"
                        Content="{x:Static resx:ResUI.TbCopyAllWorking}"
                        Style="{StaticResource DefButton}" />
                    <TextBlock
                        Margin="6,0"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.menuServers}" />
                    <ComboBox
                        Width="220"
                        Margin="0,0,6,0"
                        DisplayMemberPath="Remarks"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile}"
                        Style="{StaticResource DefComboBox}" />
                    <Button
                        x:Name="btnApply"
                        Content="{x:Static resx:ResUI.TbApplyToProfile}"
                        Style="{StaticResource DefButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top Configuration & Controls -->
        <StackPanel
            Margin="{StaticResource Margin8}"
            DockPanel.Dock="Top">
            <!-- Header -->
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{x:Static resx:ResUI.CloudflareScannerTitle}" />
            <TextBlock
                Margin="0,4,0,10"
                FontSize="12"
                Opacity="0.8"
                Text="{x:Static resx:ResUI.CloudflareScannerDesc}"
                TextWrapping="Wrap" />

            <!-- Configuration Card -->
            <Border
                Margin="0,0,0,10"
                Padding="12,10"
                BorderBrush="#40808080"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <!-- Preset -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbSubnetRange}" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding RangePresets}"
                        SelectedItem="{Binding SelectedRangePreset}"
                        Style="{StaticResource DefComboBox}" />

                    <!-- Port -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbPort}" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="0,0,10,0"
                        Style="{StaticResource DefTextBox}"
                        Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Samples -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="4"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbSampleCount}" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="5"
                        Style="{StaticResource DefTextBox}"
                        Text="{Binding SampleCount, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Host / SNI -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbTestHost}" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,8,10,0"
                        Style="{StaticResource DefTextBox}"
                        Text="{Binding TestHost, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Threads -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,8,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbThreads}" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,8,10,0"
                        Style="{StaticResource DefTextBox}"
                        Text="{Binding ThreadCount, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Speed Test Checkbox -->
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="4"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,0"
                        VerticalAlignment="Center"
                        Content="{x:Static resx:ResUI.TbEnableSpeedTest}"
                        IsChecked="{Binding EnableSpeedTest}" />
                </Grid>
            </Border>

            <!-- Scan Action Bar & Progress -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="btnStart"
                    Width="110"
                    Margin="0,0,8,0"
                    Content="{x:Static resx:ResUI.TbStartScan}"
                    IsEnabled="{Binding IsScanning, Converter={StaticResource BooleanReverseConverter}}"
                    IsDefault="True"
                    Style="{StaticResource DefButton}" />
                <Button
                    x:Name="btnStop"
                    Grid.Column="1"
                    Width="90"
                    Margin="0,0,10,0"
                    Content="{x:Static resx:ResUI.TbStopScan}"
                    IsEnabled="{Binding IsScanning}"
                    Style="{StaticResource DefButton}" />

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center">
                    <ProgressBar
                        Height="8"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding ProgressPercentage}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Opacity="0.75"
                        Text="{Binding StatusMessage}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    Orientation="Horizontal">
                    <Border
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Background="#20808080"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="12"
                            Text="{Binding ScannedCount, StringFormat='Tested: {0}'}" />
                    </Border>
                    <Border
                        Padding="8,4"
                        Background="#2028a745"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#28a745"
                            Text="{Binding WorkingCount, StringFormat='Working: {0}'}" />
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Results Table -->
        <DataGrid
            x:Name="gridResults"
            AutoGenerateColumns="False"
            BorderThickness="1"
            CanUserResizeColumns="True"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Results}"
            SelectedItem="{Binding SelectedResult}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding Ip}"
                    Header="IP Address" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding Port}"
                    Header="{x:Static resx:ResUI.TbPort}" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding PingDisplay}"
                    Header="Ping" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding DataCenter}"
                    Header="{x:Static resx:ResUI.TbDataCenter}" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Status}"
                    Header="Status" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Speed}"
                    Header="Speed" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</base:WindowBase>
