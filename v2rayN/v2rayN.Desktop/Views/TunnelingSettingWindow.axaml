<Window
    x:Class="v2rayN.Desktop.Views.TunnelingSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="Tunneling Core Settings"
    Width="620"
    Height="620"
    x:DataType="vms:TunnelingSettingViewModel"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button x:Name="btnSave" Width="110" Content="{x:Static resx:ResUI.TbConfirm}" IsDefault="True" />
            <Button x:Name="btnCancel" Width="110" Margin="{StaticResource MarginLr8}" Content="{x:Static resx:ResUI.TbCancel}" IsCancel="True" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Tunneling Core Settings" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Select the network TUN engine used when TUN mode is enabled. Choose between the standard built-in core (sing-box) or Zeptun (high-performance userspace tun2socks written in Zig)." />

                <Border BorderBrush="{DynamicResource SystemControlHighlightListAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Tunneling Engine:" />
                        <RadioButton x:Name="radSingbox"
                                     Content="Built-in (sing-box) — Standard TUN engine (Default)"
                                     GroupName="TunEngineGroup"
                                     IsChecked="{Binding IsSingboxCore}" />
                        <RadioButton x:Name="radZeptun"
                                     Content="Zeptun (Noisemux/zeptun) — High-Performance Zig TUN"
                                     GroupName="TunEngineGroup"
                                     IsChecked="{Binding IsZeptunCore}" />
                    </StackPanel>
                </Border>

                <Border x:Name="borderZeptun" BorderBrush="{DynamicResource SystemControlHighlightListAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12" IsVisible="{Binding IsZeptunSelected}">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="Zeptun Settings (Noisemux/zeptun)" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                   Text="Zeptun is a zero-dependency, ultra-fast tun2socks implementation built in Zig with elastic multi-queue workers." />

                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Interface Name" />
                            <TextBox x:Name="txtZeptunInterfaceName" Grid.Row="0" Grid.Column="1" Text="{Binding ZeptunInterfaceName}" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="MTU" />
                            <NumericUpDown x:Name="numZeptunMtu" Grid.Row="1" Grid.Column="1" Minimum="576" Maximum="65535" Value="{Binding ZeptunMtu}" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Network Stack" />
                            <ComboBox x:Name="cmbZeptunStack" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Stacks}" SelectedItem="{Binding ZeptunStack, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Extra Arguments" />
                            <TextBox x:Name="txtExtraArguments" Grid.Row="3" Grid.Column="1" Text="{Binding ExtraArguments}" />
                        </Grid>

                        <StackPanel Orientation="Vertical" Spacing="6">
                            <CheckBox x:Name="chkZeptunAutoRoute" IsChecked="{Binding ZeptunAutoRoute}" Content="Auto-route system traffic into TUN" />
                            <CheckBox x:Name="chkZeptunStrictRoute" IsChecked="{Binding ZeptunStrictRoute}" Content="Strict route protection" />
                            <CheckBox x:Name="chkZeptunDnsHijack" IsChecked="{Binding ZeptunDnsHijack}" Content="Hijack DNS queries (capture port 53)" />
                            <CheckBox x:Name="chkZeptunFakeIp" IsChecked="{Binding ZeptunFakeIp}" Content="Fake-IP DNS resolver (bypasses DNS filtering)" />
                        </StackPanel>

                        <Button x:Name="btnOpenZeptunUrl" HorizontalAlignment="Left"
                                Command="{Binding OpenZeptunUrlCmd}"
                                Content="Open Zeptun GitHub Repository (Noisemux/zeptun)" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
