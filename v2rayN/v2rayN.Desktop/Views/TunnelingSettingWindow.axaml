<Window
    x:Class="v2rayN.Desktop.Views.TunnelingSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="Tunneling Core Settings"
    Width="620"
    Height="620"
    x:DataType="vms:TunnelingSettingViewModel"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button x:Name="btnSave" Width="110" Content="{x:Static resx:ResUI.TbConfirm}" IsDefault="True" />
            <Button x:Name="btnCancel" Width="110" Margin="{StaticResource MarginLr8}" Content="{x:Static resx:ResUI.TbCancel}" IsCancel="True" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Tunneling Core Settings" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Select the network TUN engine used when TUN mode is enabled. Choose between the standard built-in core (sing-box) or Zeptun (high-performance userspace tun2socks written in Zig)." />

                <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                    <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Tunneling Engine" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Cores}" SelectedItem="{Binding SelectedCore}" />
                </Grid>

                <Border BorderBrush="{DynamicResource SystemControlHighlightListAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12" IsVisible="{Binding IsZeptunSelected}">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="Zeptun Settings (Noisemux/zeptun)" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                   Text="Zeptun is a zero-dependency, ultra-fast tun2socks implementation built in Zig with elastic multi-queue workers." />

                        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Executable Path" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ZeptunPath}" />
                            <Button Grid.Row="0" Grid.Column="2" x:Name="btnBrowseZeptun" Content="..." Width="40" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Status" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.85" Text="{Binding ZeptunStatusText}" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Interface Name" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ZeptunInterfaceName}" />

                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="MTU" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="576" Maximum="65535" Value="{Binding ZeptunMtu}" />

                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Network Stack" />
                            <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Stacks}" SelectedItem="{Binding ZeptunStack}" />

                            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Extra Arguments" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ExtraArguments}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox IsChecked="{Binding ZeptunAutoRoute}" Content="Auto-route system traffic into TUN" />
                            <CheckBox IsChecked="{Binding ZeptunStrictRoute}" Content="Strict route protection" />
                        </StackPanel>

                        <Button HorizontalAlignment="Left"
                                Command="{Binding OpenZeptunUrlCmd}"
                                Content="Open Zeptun GitHub Repository (Noisemux/zeptun)" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
