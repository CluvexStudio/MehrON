<Window
    x:Class="v2rayN.Desktop.Views.DoubleTunnelWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:ServiceLib.Models.Entities;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.DoubleTunnelTitle}"
    Width="640"
    Height="480"
    x:DataType="vms:DoubleTunnelViewModel"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Width="120"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                Width="100"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Margin="{StaticResource Margin8}" Spacing="12">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Static resx:ResUI.DoubleTunnelTitle}" />
                <TextBlock
                    FontSize="12"
                    Opacity="0.8"
                    Text="{x:Static resx:ResUI.DoubleTunnelHeaderDesc}"
                    TextWrapping="Wrap" />

                <!-- Visual Connection Flow -->
                <Border
                    Margin="0,4,0,8"
                    Padding="12"
                    BorderBrush="{DynamicResource SystemControlHighlightListLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Client" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Opacity="0.6"
                            Text="➔" />
                        <Border
                            Padding="8,4"
                            Background="{DynamicResource SystemControlHighlightListLowBrush}"
                            CornerRadius="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Text="1. Middle Server" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Opacity="0.6"
                            Text="➔" />
                        <Border
                            Padding="8,4"
                            Background="{DynamicResource SystemControlHighlightListLowBrush}"
                            CornerRadius="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Text="2. Exit Server" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Opacity="0.6"
                            Text="➔" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Internet" />
                    </StackPanel>
                </Border>

                <!-- Server Selection Form -->
                <Grid
                    ColumnDefinitions="200,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="10">
                    <!-- Middle Node -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.DoubleTunnelMiddleServer}" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Servers}"
                        SelectedItem="{Binding SelectedMiddleServer}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:ProfileItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="Medium" Text="{Binding Remarks}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.6"
                                        Text="{Binding ConfigType, StringFormat='({0})'}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.4"
                                        Text="{Binding Address}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Exit Node -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.DoubleTunnelExitServer}" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Servers}"
                        SelectedItem="{Binding SelectedExitServer}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:ProfileItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="Medium" Text="{Binding Remarks}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.6"
                                        Text="{Binding ConfigType, StringFormat='({0})'}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.4"
                                        Text="{Binding Address}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Remarks -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbRemarks}" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Text="{Binding Remarks}" />

                    <!-- Core Type -->
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="{x:Static resx:ResUI.TbCoreType}" />
                    <ComboBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="160"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding CoreTypes}"
                        SelectedItem="{Binding CoreType}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
